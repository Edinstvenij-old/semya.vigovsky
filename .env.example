APP_NAME="Family Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_TIMEZONE=Europe/Kyiv
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
# Argon2id password hashing (falls back to bcrypt if PHP lacks argon2)
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production: PostgreSQL
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=familyhub
# DB_USERNAME=familyhub
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Needed for «Забыли пароль?» emails. Locally they go to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# S3-compatible storage (MinIO, Hetzner Object Storage, Backblaze…)
# AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# --- Family Hub -------------------------------------------------------------
# Allow creating new families from the login page. Keep false in production;
# the very first family can always be created (or use `php artisan family:create`).
FAMILYHUB_ALLOW_REGISTRATION=false
# Password reset link lifetime, minutes (admin-made links are handed over in person)
AUTH_PASSWORD_RESET_EXPIRE=720
# local (private storage/app/private) or s3
FAMILYHUB_FILES_DISK=local
FAMILYHUB_BACKUP_DISK=local
FAMILYHUB_MAX_UPLOAD_KB=15360
# Minutes a 2FA code unlocks the documents module
FAMILYHUB_2FA_TTL=720
FAMILYHUB_INVITE_TTL_HOURS=72
# Optional HTTP Basic auth in front of the whole site
FAMILYHUB_BASIC_AUTH_USER=
FAMILYHUB_BASIC_AUTH_PASSWORD=

# Telegram bot for urgent notifications: create with @BotFather, then `php artisan telegram:webhook`
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any long random string; Telegram sends it back so we know the call is genuine
TELEGRAM_WEBHOOK_SECRET=

# Live flight status: key for AeroDataBox on rapidapi.com (free plan is enough)
FLIGHT_STATUS_API_KEY=

# Air-raid alerts on the dashboard: free token from https://alerts.in.ua (API section)
ALERTS_IN_UA_TOKEN=

# Web Push — generate with `php artisan push:vapid`
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
